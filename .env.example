# Copy to .env.local. Everything is optional: without keys Cloud Duet runs on the
# demo engine and sample data. Keys entered in the app (Profile → Keys &
# services / Model & API key) are per account and take priority over these.
# Keys set here are only used by the server's owner (the first account) and the
# emails in SHARED_KEYS_FOR, so strangers who sign up never spend them.

# Model — https://console.anthropic.com/settings/keys or https://platform.openai.com/api-keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Real apps (Gmail, Calendar, Drive, Slack, GitHub…) — https://platform.composio.dev
COMPOSIO_API_KEY=

# Cloud browser with a live view — https://www.browserbase.com/settings
# Without it Cloud Duet drives Chrome on this server (CHROME_PATH, default /usr/local/bin/google-chrome).
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
CHROME_PATH=

# Sign in with Google — https://console.cloud.google.com/apis/credentials
# OAuth client type "Web application", redirect URI: <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple (paid Apple Developer account)
# Services ID: https://developer.apple.com/account/resources/identifiers/list/serviceId
# Key with "Sign in with Apple": https://developer.apple.com/account/resources/authkeys/list
# Return URL: <PUBLIC_URL>/api/auth/apple/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Sign in with QQ — https://connect.qq.com/manage.html (website app; needs an
# ICP-registered domain). Callback: <PUBLIC_URL>/api/auth/qq/callback
QQ_APP_ID=
QQ_APP_KEY=
# Sign in with WeChat (QR code) — https://open.weixin.qq.com/ (verified website app).
# Authorized domain: your PUBLIC_URL host. Callback: <PUBLIC_URL>/api/auth/wechat/callback
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Sign in with Feishu — https://open.feishu.cn/app (custom app → Security settings →
# redirect URL <PUBLIC_URL>/api/auth/feishu/callback)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Sign in with DingTalk — https://open-dev.dingtalk.com/ (app → Login & sharing →
# callback <PUBLIC_URL>/api/auth/dingtalk/callback, Contact.User.Read permission)
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=

# Public https address, used for OAuth redirects, Composio callbacks and share
# links. Set it in production. Defaults to the request's Host header.
PUBLIC_URL=
# Set to 1 only behind a reverse proxy you control, to trust X-Forwarded-* headers.
TRUST_PROXY=

# Who may use this server. The first account is the owner.
# ALLOW_SIGNUP=false stops new accounts; ALLOWED_EMAILS limits them
# (comma-separated emails or @domains).
ALLOW_SIGNUP=
ALLOWED_EMAILS=
# Other accounts that may use the keys above (comma-separated emails, or *).
SHARED_KEYS_FOR=

# Set to 1 to let the built-in browser open localhost and private-network
# addresses (local development only).
BROWSER_ALLOW_PRIVATE=

# Generated into data/ on first run when empty.
AUTH_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Where accounts and workspaces live (default ./data).
DUET_DATA_DIR=
